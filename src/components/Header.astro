---
const links = [
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#education', label: 'Education' },
  { href: '#skills', label: 'Skills' },
  { href: '#projects', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
];
---
<header class="site-header">
  <div class="wrap header-inner">
    <a href="#top" class="wordmark">sam<span>@</span>lamartina</a>
    <nav>
      <ul>
        {links.map(link => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(15, 27, 51, 0.85);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--blueprint-line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  .wordmark {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--paper);
  }
  .wordmark span {
    color: var(--amber);
  }
  .wordmark:hover {
    text-decoration: none;
    color: var(--paper);
  }
  nav ul {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--paper-dim);
  }
  nav a:hover {
    color: var(--amber);
    text-decoration: none;
  }
  @media (max-width: 560px) {
    nav ul {
      gap: 1rem;
    }
    nav a {
      font-size: 0.75rem;
    }
  }
</style>
