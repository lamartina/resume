---
const systemSkills = [
  { name: "Linux / UNIX", level: 90 },
  { name: "Web Server Config", level: 85 },
  { name: "Amazon AWS", level: 70 },
  { name: "Microsoft Azure", level: 60 },
];

const codeSkills = ["Python", "Bash", "PHP", "MySQL"];
const languages = ["English", "German"];

const knowledge = [
  "Python Scripting",
  "Web Hosting Infrastructure",
  "Search Engine Optimization",
  "Linux & Windows Management",
  "Network Configuration & Buildout",
  "JIRA / Atlassian Suite",
  "Google Data Studio",
  "Basic Java",
  "cPanel / WHM",
  "CI/CD Pipelines",
  "Malware Mitigation",
  "Patch Management",
];
---

<section id="skills" class="section">
  <div class="container">
    <div class="section-label">
      <span class="label-num">03</span>
      <span class="label-text">Skills</span>
    </div>

    <h2 class="section-title">Technical<br /><em>Toolkit</em></h2>

    <div class="skills-grid">
      <!-- System skills w/ bars -->
      <div class="skill-block">
        <h3 class="skill-block-title">System Proficiency</h3>
        <div class="bars">
          {systemSkills.map(skill => (
            <div class="bar-item">
              <div class="bar-meta">
                <span class="bar-name">{skill.name}</span>
                <span class="bar-pct">{skill.level}%</span>
              </div>
              <div class="bar-track">
                <div class="bar-fill" style={`--pct: ${skill.level}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Coding languages -->
      <div class="skill-block">
        <h3 class="skill-block-title">Languages & Code</h3>
        <div class="pill-grid">
          {codeSkills.map(s => (
            <div class="pill code">{s}</div>
          ))}
        </div>

        <h3 class="skill-block-title" style="margin-top: 2rem">Spoken Languages</h3>
        <div class="pill-grid">
          {languages.map(l => (
            <div class="pill lang">{l}</div>
          ))}
        </div>
      </div>

      <!-- Knowledge tags -->
      <div class="skill-block wide">
        <h3 class="skill-block-title">Knowledge & Tools</h3>
        <div class="knowledge-tags">
          {knowledge.map(k => (
            <span class="know-tag">{k}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    background: rgba(20, 33, 61, 0.92);
    backdrop-filter: blur(4px);
    padding: 7rem 0;
    border-top: 1px solid var(--border);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .label-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .label-text {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 3rem;
  }

  .section-title em {
    font-style: normal;
    color: var(--accent);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .skill-block.wide {
    grid-column: 1 / -1;
  }

  .skill-block-title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 1.25rem;
  }

  /* Bars */
  .bars {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .bar-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }

  .bar-name {
    font-size: 0.88rem;
    font-weight: 600;
  }

  .bar-pct {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
  }

  .bar-track {
    height: 3px;
    background: var(--bg-3);
    border-radius: 2px;
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    width: var(--pct);
    background: linear-gradient(90deg, var(--accent), var(--accent-2));

    border-radius: 2px;
    animation: growBar 1.2s ease forwards;
    transform-origin: left;
  }

  @keyframes growBar {
    from { width: 0; }
    to { width: var(--pct); }
  }

  /* Pills */
  .pill-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .pill {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.45rem 1rem;
    border-radius: 2px;
    letter-spacing: 0.04em;
  }

  .pill.code {
    background: rgba(255, 140, 66, 0.1);
    border: 1px solid rgba(255, 140, 66, 0.3);
    color: var(--accent-2);
  }

  .pill.lang {
    background: rgba(79, 209, 197, 0.08);
    border: 1px solid rgba(79, 209, 197, 0.2);
    color: var(--accent);
  }

  /* Knowledge tags */
  .knowledge-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .know-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 0.35rem 0.8rem;
    border-radius: 2px;
    background: var(--bg-3);
    transition: all 0.2s;
  }

  .know-tag:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(255, 140, 66, 0.05);
  }

  @media (max-width: 700px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
    .skill-block.wide {
      grid-column: 1;
    }
  }
</style>
