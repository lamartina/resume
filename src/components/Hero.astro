---
const roles = [
  'System Administrator',
  'Network Engineer',
  'Cyber Security',
  'Computer Repair',
  'LGBTQ+ Outreach',
];

const stats = [
  { value: '15+', label: 'Years Experience' },
  { value: '50', label: 'States Visited' },
  { value: '3', label: 'Active Roles' },
];
---
<section id="top" class="hero">
  <div class="wrap hero-grid">
    <p class="tagline">
      Building reliable infrastructure and securing systems from West Virginia &mdash; for clients nationwide.
    </p>
    <div class="stats-bar">
      {stats.map(s => (
        <div class="stat">
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
    <div class="terminal panel">
      <div class="terminal-bar">
        <span class="dot dot-r"></span>
        <span class="dot dot-y"></span>
        <span class="dot dot-g"></span>
        <span class="terminal-title">sam@lamartina: ~</span>
      </div>
      <div class="terminal-body">
        <p><span class="prompt">$</span> whoami</p>
        <p class="output">Sam R. LaMartina</p>
        <p><span class="prompt">$</span> cat roles.txt</p>
        <ul class="output roles">
          {roles.map(role => <li><span class="status-dot"></span>{role}</li>)}
        </ul>
        <p><span class="prompt">$</span> cat location.txt</p>
        <p class="output">West Virginia, USA &mdash; open to remote work</p>
        <p class="prompt-line"><span class="prompt">$</span> <span class="cursor">_</span></p>
      </div>
    </div>
    <div class="hero-actions">
      <a class="btn btn--solid" href="/resume.pdf" download>Download resume.pdf</a>
      <a class="btn" href="#contact">Get in touch</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 4rem;
    padding-bottom: 3rem;
  }
  .hero-grid {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .tagline {
    max-width: 46ch;
    font-size: 1.15rem;
    color: var(--paper);
    margin: 0;
  }
  .stats-bar {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
  }
  .stat {
    display: flex;
    flex-direction: column;
  }
  .stat-value {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--amber);
    line-height: 1.1;
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--paper-dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .terminal {
    overflow: hidden;
  }
  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    background: var(--panel-navy-light);
    border-bottom: 1px solid var(--blueprint-line);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .dot-r { background: #FF5F56; }
  .dot-y { background: #FFBD2E; }
  .dot-g { background: #27C93F; }
  .terminal-title {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--paper-dim);
  }
  .terminal-body {
    padding: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }
  .terminal-body p {
    margin: 0.35rem 0;
  }
  .prompt {
    color: var(--teal);
    margin-right: 0.5em;
  }
  .output {
    color: var(--paper);
    margin-left: 1.2em;
  }
  .roles {
    list-style: none;
    padding: 0;
    margin: 0.35rem 0 0.35rem 1.2em;
  }
  .roles li {
    margin: 0.2rem 0;
  }
  .cursor {
    display: inline-block;
    color: var(--amber);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
