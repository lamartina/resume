---
---
<section id="home" class="hero">
  <div class="hero-inner">
    <div class="hero-label">
      <span class="dot"></span>
      <span>Available for freelance</span>
    </div>
    <h1 class="hero-name">
      <span class="name-line">Sam</span>
      <span class="name-line accent">LaMartina</span>
    </h1>
    <div class="hero-roles">
      <span class="role" data-index="0">DevOps Engineer</span>
      <span class="role" data-index="1">System Administrator</span>
      <span class="role" data-index="2">Network Engineer</span>
      <span class="role" data-index="3">Cybersecurity</span>
    </div>
    <p class="hero-tagline">
      Building reliable infrastructure and securing systems<br />
      from Moundsville, WV — for the whole country.
    </p>
    <div class="hero-actions">
      <a href="#contact" class="btn-primary">Get In Touch</a>
    </div>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-num">15+</span>
        <span class="stat-label">Years Experience</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-num">50</span>
        <span class="stat-label">States Visited</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-num">3</span>
        <span class="stat-label">Active Roles</span>
      </div>
    </div>
  </div>

  <div class="hero-terminal">
    <div class="terminal-header">
      <span class="terminal-dot red"></span>
      <span class="terminal-dot yellow"></span>
      <span class="terminal-dot green"></span>
      <span class="terminal-title">sam@wolfden ~ $</span>
    </div>
    <div class="terminal-body">
      <div class="terminal-line">
        <span class="prompt">❯</span>
        <span class="cmd"> whoami</span>
      </div>
      <div class="terminal-output">sam_lamartina</div>
      <div class="terminal-line">
        <span class="prompt">❯</span>
        <span class="cmd"> cat roles.txt</span>
      </div>
      <div class="terminal-output">DevOps @ DevMats</div>
      <div class="terminal-output">SysAdmin @ InMotion Hosting</div>
      <div class="terminal-output">Network Eng @ WolfDen Networks</div>
      <div class="terminal-line">
        <span class="prompt">❯</span>
        <span class="cmd"> uptime --years</span>
      </div>
      <div class="terminal-output terminal-green">15+ years in ops</div>
      <div class="terminal-line">
        <span class="prompt">❯</span>
        <span class="cmd"> echo $STATUS</span>
      </div>
      <div class="terminal-output terminal-accent">
        🟢 Available for freelance work
      </div>
      <div class="terminal-line blink-line">
        <span class="prompt">❯</span>
        <span class="cursor">▊</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 4rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 7rem 2rem 4rem;
    position: relative;
  }

  :global(#home) {
    background: rgba(15, 27, 51, 0.75);
  }

  .hero-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-2);
    margin-bottom: 1.5rem;
  }

  .dot {
    width: 7px;
    height: 7px;
    background: var(--accent-2);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 7vw, 6rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  .name-line {
    display: block;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.7s ease forwards;
  }

  .name-line:nth-child(2) {
    animation-delay: 0.1s;
  }

  .accent {
    color: var(--accent);
  }

  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .role {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 0.3rem 0.75rem;
    border-radius: 2px;
    background: rgba(255, 140, 66, 0.04);
  }

  .hero-tagline {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 2.5rem;
    max-width: 460px;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--accent);
    color: var(--bg);
    padding: 0.75rem 1.75rem;
    border-radius: 2px;
    font-weight: 700;
    transition: all 0.2s;
  }

  .btn-primary:hover {
    background: var(--accent-2);
    opacity: 1;
  }

  .btn-ghost {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 0.75rem 1.75rem;
    border-radius: 2px;
    transition: all 0.2s;
  }

  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
    opacity: 1;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .stat-num {
    display: block;
    font-family: var(--font-sans);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.04em;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .stat-divider {
    width: 1px;
    height: 36px;
    background: var(--border);
  }

  /* Terminal */
  .hero-terminal {
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 0 60px rgba(58, 75, 117, 0.3), 0 24px 80px rgba(0,0,0,0.5);
    animation: fadeUp 0.9s ease 0.2s forwards;
    opacity: 0;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.8rem 1rem;
    background: var(--bg-3);
    border-bottom: 1px solid var(--border);
  }

  .terminal-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }
  .terminal-dot.red    { background: #ff5f57; }
  .terminal-dot.yellow { background: #febc2e; }
  .terminal-dot.green  { background: #28c840; }

  .terminal-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-left: 0.5rem;
  }

  .terminal-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .terminal-line {
    display: flex;
    align-items: center;
  }

  .prompt {
    color: var(--accent-2);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    margin-right: 0.4rem;
  }

  .cmd {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text);
  }

  .terminal-output {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
    padding-left: 1.4rem;
  }

  .terminal-green { color: #28c840; }
  .terminal-accent { color: var(--accent-2); }

  .cursor {
    font-family: var(--font-mono);
    color: var(--accent-2);
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-terminal {
      display: none;
    }
  }
</style>
