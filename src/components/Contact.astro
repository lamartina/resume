---
const socials = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/srlamartina/' },
  { label: 'GitHub', href: 'https://github.com/lamartina' },
  { label: 'Stack Overflow', href: 'https://stackoverflow.com/users/20841198/lamartina' },
];
---
<section id="contact">
  <div class="wrap">
    <span class="eyebrow">// 08 contact</span>
    <h2 class="section-title">Open a connection</h2>
    <div class="contact-panel panel">
      <p><span class="status-dot"></span>Available for freelance and remote work</p>
      <p class="contact-line"><span class="label">Email</span><a href="mailto:me@srlamartina.com">me@srlamartina.com</a></p>
      <div class="socials">
        {socials.map(s => <a class="btn" href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>)}
      </div>
    </div>

    <form class="contact-form panel" method="GET" action="mailto:me@srlamartina.com" enctype="text/plain">
      <div class="form-row">
        <label>
          <span>Name</span>
          <input type="text" name="name" required />
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" required />
        </label>
      </div>
      <label>
        <span>Subject</span>
        <input type="text" name="subject" />
      </label>
      <label>
        <span>Message</span>
        <textarea name="message" rows="4"></textarea>
      </label>
      <button type="submit" class="btn btn--solid">Send message →</button>
      <p class="form-note">Opens your email client with this pre-filled — nothing is submitted directly from this static site.</p>
    </form>
  </div>
</section>

<style>
  .contact-panel {
    padding: 2rem;
    margin-top: 2rem;
  }
  .contact-panel > p {
    margin: 0 0 1rem;
  }
  .contact-line {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-mono);
  }
  .label {
    color: var(--paper-dim);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .socials {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .contact-form {
    padding: 1.75rem 2rem;
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (max-width: 560px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--paper-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .contact-form input,
  .contact-form textarea {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--paper);
    background: var(--panel-navy-light);
    border: 1px solid var(--blueprint-line);
    border-radius: 4px;
    padding: 0.6em 0.75em;
    text-transform: none;
    letter-spacing: normal;
  }
  .contact-form button {
    align-self: flex-start;
    cursor: pointer;
    font-size: 0.9rem;
  }
  .form-note {
    margin: 0;
    font-size: 0.78rem;
    color: var(--paper-dim);
    text-transform: none;
    letter-spacing: normal;
  }
</style>
